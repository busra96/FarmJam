  - key: merge_title
    english: MERGE CARDS
    turkish: "KARTLARI B\u0130RLE\u015ET\u0130R"
    spanish: FUSIONA CARTAS
    chinese: "\u5408\u5E76\u5361\u724C"
  - key: merge_rules
    english: "MERGE CARDS\n<size=58%>1 + 1 = 2   \u2022   2 + 2 = 3   \u2022   3
      + 3 = 4</size>"
    turkish: "KARTLARI B\u0130RLE\u015ET\u0130R\n<size=58%>1 + 1 = 2   \u2022   2
      + 2 = 3   \u2022   3 + 3 = 4</size>"
    spanish: "FUSIONA CARTAS\n<size=58%>1 + 1 = 2   \u2022   2 + 2 = 3   \u2022  
      3 + 3 = 4</size>"
    chinese: "\u5408\u5E76\u5361\u724C\n<size=58%>1 + 1 = 2   \u2022   2 + 2 = 3  
      \u2022   3 + 3 = 4</size>"
  - key: tutorial_merge
    english: '1 / 2   MERGE MATCHING CARDS

      <size=72%>Drag one card onto the
      other: 1 + 1 = 2</size>'
    turkish: "1 / 2   AYNI KARTLARI B\u0130RLE\u015ET\u0130R\n<size=72%>Bir kart\u0131
      di\u011Ferine s\xFCr\xFCkle: 1 + 1 = 2</size>"
    spanish: '1 / 2   FUSIONA CARTAS IGUALES

      <size=72%>Arrastra una carta
      sobre la otra: 1 + 1 = 2</size>'
    chinese: "1 / 2   \u5408\u5E76\u76F8\u540C\u5361\u724C\n<size=72%>\u5C06\u4E00\u5F20\u5361\u724C\u62D6\u5230\u53E6\u4E00\u5F20\u4E0A\uFF1A1
      + 1 = 2</size>"
  - key: tutorial_place
    english: '2 / 2   MAKE YOUR FIRST BOX

      <size=72%>Drag the 2 card onto a
      2-box shape</size>'
    turkish: "2 / 2   \u0130LK KUTUNU YERLE\u015ET\u0130R\n<size=72%>2 kart\u0131n\u0131
      ikili kutu alan\u0131na s\xFCr\xFCkle</size>"
    spanish: '2 / 2   COLOCA TU PRIMERA CAJA

      <size=72%>Arrastra la carta 2
      a una forma de 2 cajas</size>'
    chinese: "2 / 2   \u653E\u7F6E\u7B2C\u4E00\u7EC4\u7BB1\u5B50\n<size=72%>\u5C06\u6570\u5B572\u7684\u5361\u724C\u62D6\u5230\u53CC\u7BB1\u533A\u57DF</size>"
  - key: hint_drag
    english: DRAG {0} TO A MATCHING {0}-BOX SHAPE
    turkish: "{0} KARTINI {0} KUTULU ALANA S\xDCR\xDCKLE"
    spanish: ARRASTRA {0} A UNA FORMA DE {0} CAJAS
    chinese: "\u5C06{0}\u5361\u724C\u62D6\u5230{0}\u7BB1\u533A\u57DF"
  - key: hint_match
    english: MATCH BOTH COLOR AND NUMBER
    turkish: RENK VE SAYI AYNI OLMALI
    spanish: "EL COLOR Y EL N\xDAMERO DEBEN COINCIDIR"
    chinese: "\u989C\u8272\u548C\u6570\u5B57\u90FD\u5FC5\u987B\u76F8\u540C"
  - key: hint_merged
    english: MATCH! TWO {0} CARDS MAKE {1}
    turkish: "HAR\u0130KA! \u0130K\u0130 {0} KARTI {1} OLUR"
    spanish: "\xA1BIEN! DOS CARTAS {0} HACEN {1}"
    chinese: "\u6210\u529F\uFF01\u4E24\u5F20{0}\u5361\u724C\u5408\u6210{1}"
  - key: hint_next
    english: NICE! CHECK ITEMS LEFT FOR YOUR NEXT BOX
    turkish: "G\xDCZEL! SONRAK\u0130 KUTU \u0130\xC7\u0130N KALAN \xDCR\xDCNLERE
      BAK"
    spanish: "\xA1BIEN! MIRA LOS PRODUCTOS RESTANTES"
    chinese: "\u5F88\u597D\uFF01\u6839\u636E\u5269\u4F59\u7269\u54C1\u89C4\u5212\u4E0B\u4E00\u7EC4\u7BB1\u5B50"
  - key: hint_busy
    english: "THAT SPACE IS BUSY \u2014 TRY AN EMPTY SHAPE"
    turkish: "BU ALAN DOLU \u2014 BO\u015E B\u0130R ALAN DENE"
    spanish: "ESE ESPACIO EST\xC1 OCUPADO \u2014 PRUEBA OTRO"
    chinese: "\u8BE5\u533A\u57DF\u5DF2\u88AB\u5360\u7528\uFF0C\u8BF7\u9009\u62E9\u7A7A\u95F2\u533A\u57DF"
  - key: hint_shape
    english: THIS SHAPE NEEDS A {0} CARD
    turkish: "BU ALANA {0} KARTI GEREK\u0130YOR"
    spanish: ESTA FORMA NECESITA UNA CARTA {0}
    chinese: "\u6B64\u533A\u57DF\u9700\u8981\u6570\u5B57{0}\u7684\u5361\u724C"
